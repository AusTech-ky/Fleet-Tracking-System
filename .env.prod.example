# Production configuration for docker-compose.prod.yml.
# Copy to .env, fill in, and keep it OUT of version control.
#
#   cp .env.prod.example .env

# --- Domains (must already point at this host's public IP) ---------------
APP_DOMAIN=fleet.example.com          # web app
API_DOMAIN=api.fleet.example.com      # API / WebSocket / GraphQL
ACME_EMAIL=ops@example.com            # Let's Encrypt notifications

# --- Secrets (generate strong values) ------------------------------------
#   openssl rand -hex 32
POSTGRES_PASSWORD=change-me-long-random
JWT_SECRET=change-me-long-random

# --- Device ingestion -----------------------------------------------------
# The TCP port your Teltonika devices dial into (server port 2005 on the
# device). Must be open in the host/cloud firewall.
INGEST_TCP_PORT=5027
# UDP: set to a port number to enable, or "off".
INGEST_UDP_PORT=off
INGEST_MAX_CONNECTIONS=50000
# TLS for device traffic requires certs in ./certs AND certs loaded onto each
# device via the Teltonika Configurator/FOTA. Leave false until provisioned.
INGEST_TLS_ENABLED=false

# --- Optional -------------------------------------------------------------
THROTTLE_LIMIT=300                    # API requests per IP per minute
DEFAULT_BASEMAP=streets               # streets | satellite | hybrid | terrain
# SMTP_URL=smtps://user:pass@smtp.example.com:465   # alert emails
TRIP_STOP_MIN_SEC=180                 # stop duration that ends a trip
