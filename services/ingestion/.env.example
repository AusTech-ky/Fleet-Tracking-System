# Teltonika ingestion service configuration (see src/config.ts)

# Device-facing ports
TCP_PORT=5027
UDP_PORT=5027          # set to "off" to disable UDP
HTTP_PORT=9100         # health + metrics (never expose to devices)

# TLS (device certs pre-loaded via Teltonika Configurator/FOTA)
TLS_ENABLED=false
# TLS_KEY_PATH=/etc/certs/server.key
# TLS_CERT_PATH=/etc/certs/server.crt
# TLS_CA_PATH=/etc/certs/ca.crt   # set to require device client certs (mTLS)

# Device allow-list (comma-separated IMEIs). Empty = allow all (DEV ONLY).
ALLOWED_IMEIS=

# Durability + dedupe
WAL_DIR=./.wal
DEDUPE_TTL_SECONDS=86400
# REDIS_URL=redis://localhost:6379   # enables shared cross-node dedupe

# Connection management
IDLE_TIMEOUT_MS=300000
MAX_CONNECTIONS=50000
SHUTDOWN_GRACE_MS=15000
ACTIVE_DATALINK_TIMEOUT_SEC=259200   # recommended device-side value for downlink

LOG_LEVEL=info
